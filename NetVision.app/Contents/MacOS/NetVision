#!/bin/bash
APP_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
if command -v python3 >/dev/null 2>&1; then
  python3 "$APP_ROOT/start_server.py" --background
  if [ "$?" -ne 0 ]; then
    osascript -e 'display dialog "NetVision SQLite could not start. See var/server.log in the project directory. A Python server is required." buttons {"OK"} default button "OK"'
  fi
else
  osascript -e 'display dialog "Python 3.10 or newer is required. Install Python, then start NetVision again." buttons {"OK"} default button "OK"'
fi
