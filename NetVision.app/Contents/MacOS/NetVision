#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
APP_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
mkdir -p "$APP_ROOT/var"
if python3 "$APP_ROOT/start_server.py" --background >>"$APP_ROOT/var/launcher.log" 2>&1; then
  server_url=$(cat "$APP_ROOT/var/.netvision-url")
  /usr/bin/open "$server_url"
  /usr/bin/osascript - "$server_url" <<'APPLESCRIPT'
on run argv
  display dialog ("NetVision běží. Pokud se prohlížeč neotevřel, zkopírujte tuto adresu do Safari nebo Chrome:") default answer (item 1 of argv) buttons {"OK"} default button "OK"
end run
APPLESCRIPT
else
  /usr/bin/osascript -e 'display dialog "NetVision se nepodařilo spustit. Podrobnosti jsou ve var/launcher.log a var/server.log ve složce aplikace." buttons {"OK"}'
fi
