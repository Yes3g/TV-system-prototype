#!/bin/bash
APP_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"

if command -v python3 >/dev/null 2>&1; then
  python3 "$APP_ROOT/start_server.py" --background
  STATUS=$?
  if [ "$STATUS" -ne 0 ]; then
    osascript -e 'display dialog "NetVision could not start its local server. Opening index.html instead." buttons {"OK"} default button "OK"'
    open "$APP_ROOT/index.html"
  fi
else
  osascript -e 'display dialog "Python 3 was not found. Opening NetVision as a local file instead." buttons {"OK"} default button "OK"'
  open "$APP_ROOT/index.html"
fi
